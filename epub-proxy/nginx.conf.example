# Example reverse-proxy config for epub-proxy, terminating TLS and
# enforcing rate limits in front of the container (which itself only speaks
# plain HTTP on :8080 and does no rate limiting of its own -- see app.py).
#
# Adjust server_name / cert paths / upstream port to your setup and drop
# this into e.g. /etc/nginx/sites-available/epub-proxy.conf.

# Shared across all worker processes (unlike an in-app limiter, which would
# need external shared storage to behave correctly behind multiple
# gunicorn workers). 10m ~ enough state for tens of thousands of tracked IPs.
limit_req_zone $binary_remote_addr zone=epub_proxy:10m rate=10r/m;

server {
    listen 443 ssl http2;
    server_name your-proxy.example.com;

    ssl_certificate     /etc/letsencrypt/live/your-proxy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-proxy.example.com/privkey.pem;

    location /healthz {
        proxy_pass http://127.0.0.1:8080;
    }

    location /optimize/ {
        limit_req zone=epub_proxy burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # First request for a given book can take a while (fetch + image
        # processing); cached requests are near-instant. Give the slow path
        # room without holding the connection open indefinitely.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        # Response bodies are whole EPUB files, sometimes tens of MB.
        client_max_body_size 0;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name your-proxy.example.com;
    return 301 https://$host$request_uri;
}
